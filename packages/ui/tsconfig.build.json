{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src"],
  // Tests may live beside their source files, but are type-checked only and
  // must never be emitted into the published package.
  "exclude": ["tests", "**/*.test.*", "**/*.spec.*", "**/*.stories.*", "**/internal/storybook/**", "**/stories/**"],
  // Emit extensioned relative specifiers so dist is resolvable by Node's ESM
  // loader, not just by bundlers.
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
