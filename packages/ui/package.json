{
  "name": "@vireocodedev/starter-ui",
  "version": "1.1.0",
  "description": "MUI-based UI component library (responsive cards, mobile tables, overlays, providers, hooks, formatters) for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "ui",
    "mui",
    "react",
    "components",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && copyfiles -u 1 \"src/**/*.css\" dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@vireocodedev/starter-history": "^0.3.0",
    "@vireocodedev/starter-localization": "^0.7.0"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=6",
    "@mui/material": ">=6",
    "@mui/x-date-pickers": ">=7",
    "@rgo/front-ui": ">=1.9",
    "dayjs": ">=1.11",
    "i18next": ">=25",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "react-i18next": ">=15",
    "sonner": ">=2"
  },
  "devDependencies": {
    "@mui/icons-material": "^6.4.3",
    "@mui/material": "^6.4.1",
    "@mui/x-date-pickers": "^7.27.0",
    "@rgo/front-ui": "^1.9.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "copyfiles": "^2.4.1",
    "dayjs": "^1.11.13",
    "i18next": "^25.4.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "rimraf": "^6.0.1",
    "sonner": "^2.0.7",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
