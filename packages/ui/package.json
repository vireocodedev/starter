{
  "name": "@vireocodedev/starter-ui",
  "version": "2.1.0",
  "description": "MUI-based UI component library (responsive cards, mobile tables, overlays, providers, hooks, formatters) for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "ui",
    "mui",
    "react",
    "components",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "copyfiles -u 1 \"src/**/*.css\" dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run build:css",
    "dev": "concurrently -k -n tsc,aliases,css \"npm run dev:tsc\" \"npm run dev:aliases\" \"npm run dev:css\"",
    "dev:tsc": "tsc -w -p tsconfig.build.json",
    "dev:aliases": "tsc-alias -w -p tsconfig.build.json",
    "dev:css": "chokidar \"src/**/*.css\" -c \"npm run build:css\" --initial",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^4.1.3",
    "@vireocodedev/starter-history": "^0.4.0",
    "@vireocodedev/starter-localization": "^0.8.0",
    "country-flag-icons": "^1.5.16",
    "html-react-parser": "^5.2.5",
    "i18n-iso-countries": "^7.14.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "idb": "^8.0.3",
    "jsoncrush": "^1.1.8",
    "ovenplayer": "^0.10.42",
    "react-error-boundary": "^5.0.0",
    "react-hot-toast": "^2.6.0",
    "react-timer-hook": "^3.0.8",
    "react-use": "^17.6.0"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/icons-material": ">=6",
    "@mui/material": ">=6",
    "@mui/x-date-pickers": ">=7",
    "@tanstack/react-query": ">=5",
    "axios": ">=1.7",
    "dayjs": ">=1.11",
    "i18next": ">=25",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": ">=7",
    "react-i18next": ">=15",
    "sonner": ">=2",
    "zod": ">=3.24"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.3",
    "@mui/material": "^6.4.1",
    "@mui/x-date-pickers": "^7.27.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-themes": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tanstack/react-query": "^5.64.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.4",
    "@types/ovenplayer": "^0.10.12",
    "@types/react": "^18.3.18",
    "axios": "^1.7.9",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "dayjs": "^1.11.13",
    "i18next": "^25.4.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "rimraf": "^6.0.1",
    "sonner": "^2.0.7",
    "storybook": "^9.1.20",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
