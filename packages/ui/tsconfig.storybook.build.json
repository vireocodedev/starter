{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./storybook",
    "outDir": "./dist/storybook",
    "paths": {
      "@vireocodedev/ui/localization": ["./dist/integrations/localization/public.d.ts"],
      "@vireocodedev/ui/theme": ["./dist/core/utils/themeutils.d.ts"]
    }
  },
  "include": ["storybook"],
  "exclude": ["**/*.test.*", "**/*.spec.*"],
  "tsc-alias": {
    "resolveFullPaths": true
  }
}
