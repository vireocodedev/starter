{
  "name": "@vireocodedev/starter-sqlite",
  "version": "0.2.0",
  "description": "Reusable SQLite worker/client runtime primitives for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/sqlite"
  },
  "keywords": [
    "sqlite",
    "opfs",
    "worker",
    "runtime",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
