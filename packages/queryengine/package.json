{
  "name": "@vireocodedev/starter-queryengine",
  "version": "1.1.0",
  "description": "Framework-agnostic query engine client (models, api, react-query, signals) for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/queryengine"
  },
  "keywords": [
    "queryengine",
    "filters",
    "react-query",
    "zod",
    "signals",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@preact/signals-react": ">=2",
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@preact/signals-react": "^3.10.2",
    "@tanstack/react-query": "^5.64.2",
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "zod": "^3.24.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
