{
  "name": "@vireocodedev/starter-localization",
  "version": "2.0.0",
  "description": "Foundation i18n toolkit and shared platform translations for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/localization"
  },
  "keywords": [
    "i18n",
    "i18next",
    "localization",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "i18next": ">=25"
  },
  "devDependencies": {
    "i18next": "^25.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
