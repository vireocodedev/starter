{
  "name": "@vireocodedev/starter-core",
  "version": "0.8.0",
  "description": "App-shell framework for the vireocodedev starter product: config/sitemap/routing scaffolding, route guards, the responsive shell + navigation, and shell layout presets.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/core"
  },
  "keywords": [
    "app-shell",
    "navigation",
    "routing",
    "mui",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "import": "./dist/offline/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@vireocodedev/starter-infrastructure": "^0.3.0",
    "@vireocodedev/starter-localization": "^0.7.0",
    "@vireocodedev/starter-ui": "^2.0.0"
  },
  "peerDependencies": {
    "@mui/icons-material": ">=6",
    "@mui/material": ">=6",
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router": ">=7 <8"
  },
  "peerDependenciesMeta": {
    "vite-plugin-pwa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mui/icons-material": "^6.4.3",
    "@mui/material": "^6.4.1",
    "@tanstack/react-query": "^5.64.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "i18next": "^25.4.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router": "^7.6.3",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
