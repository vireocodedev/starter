{
  "name": "@vireocodedev/starter-infrastructure",
  "version": "0.3.0",
  "description": "Framework-agnostic frontend infrastructure utilities (network status, persistent signals, date/array helpers, session-expiry events, axios helpers, tanstack query client) for the vireocodedev starter product.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vireocodedev/starter.git",
    "directory": "packages/infrastructure"
  },
  "keywords": [
    "infrastructure",
    "network-status",
    "signals",
    "tanstack-query",
    "starter"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "peerDependencies": {
    "@preact/signals-react": ">=2",
    "@tanstack/react-query": ">=5",
    "axios": ">=1.7",
    "dayjs": ">=1.11",
    "react": ">=18"
  },
  "devDependencies": {
    "@preact/signals-react": "^3.10.2",
    "@tanstack/react-query": "^5.64.2",
    "@types/react": "^18.3.18",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
