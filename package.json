{
  "name": "@vireocodedev/starter",
  "private": true,
  "version": "0.0.0",
  "description": "vireocodedev starter — shared frontend libraries. The backend libraries live in jvm/ and are built by Gradle.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "verify": "sh scripts/verify.sh",
    "verify:all": "sh scripts/verify-all.sh",
    "storybook": "npm run storybook --workspace=@vireocodedev/starter-ui",
    "build-storybook": "npm run build-storybook --workspace=@vireocodedev/starter-ui",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck --concurrency=5",
    "test": "npm run test:architecture && turbo run test && npm run surface",
    "test:architecture": "node --test scripts/ui-architecture.test.mjs && node scripts/ui-architecture.mjs && node scripts/ui-loading-contracts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "api:inventory": "node scripts/api-inventory.mjs",
    "surface": "node scripts/public-surface.mjs",
    "surface:update": "node scripts/public-surface.mjs --update",
    "types:strict": "node scripts/strict-consumer-types.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:test": "node --test scripts/generator/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:smoke": "node scripts/release-pack-smoke.mjs",
    "public:audit": "sh scripts/public-repository-audit.sh",
    "release": "npm run verify -- silent && npm run release:smoke && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.10.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "npm@12.0.2"
}
