{
  "name": "@vireocodedev/starter",
  "private": true,
  "version": "0.0.0",
  "description": "vireocodedev starter — shared frontend libraries.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm run test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/node": "^20",
    "turbo": "^2.10.8",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@11.16.0"
}
