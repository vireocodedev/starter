{
  "name": "@vireocodedev/starter",
  "private": true,
  "version": "0.0.0",
  "description": "vireocodedev starter — shared frontend libraries. The backend libraries live in jvm/ and are built by Gradle.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "12.0.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "verify": "sh scripts/verify.sh",
    "verify:all": "sh scripts/verify-all.sh",
    "storybook": "sh scripts/with-declared-npm.sh npm run storybook --workspace=@vireocodedev/ui",
    "build-storybook": "sh scripts/with-declared-npm.sh npm run build-storybook --workspace=@vireocodedev/ui",
    "docs:portal": "node scripts/build-documentation-portal.mjs",
    "docs:check": "node scripts/documentation-policy.mjs",
    "docs:check:artifact": "node scripts/documentation-policy.mjs --artifact",
    "site:build": "node site/build.mjs",
    "site:check": "node site/verify.mjs",
    "site:check:artifact": "node site/verify.mjs --artifact",
    "site:test": "node --test site/build.test.mjs",
    "site:deploy:vps": "sh site/deploy-vps.sh",
    "site:stage:vps": "sh site/stage-vps-bootstrap.sh",
    "build-docs": "corepack npm run build && corepack npm run build-storybook && ./jvm/gradlew -p jvm aggregateJavadoc && corepack npm run docs:portal && corepack npm run docs:check:artifact",
    "build": "sh scripts/with-declared-npm.sh turbo run build",
    "dev": "sh scripts/with-declared-npm.sh turbo run dev",
    "typecheck": "sh scripts/with-declared-npm.sh turbo run typecheck --concurrency=5",
    "test": "sh scripts/with-declared-npm.sh sh scripts/test.sh",
    "test:architecture": "node --test scripts/ui-architecture.test.mjs && node scripts/ui-architecture.mjs && node scripts/ui-loading-contracts.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:policy": "node scripts/public-api-policy.mjs",
    "surface": "node scripts/public-surface.mjs",
    "surface:update": "node scripts/public-surface.mjs --update",
    "types:strict": "node scripts/strict-consumer-types.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:test": "node --test scripts/generator/*.test.mjs",
    "generate:entity:fixture": "node scripts/generated-entity-fixture.mjs",
    "upgrade:project:fixture": "node scripts/project-upgrade-fixture.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "node scripts/changeset-version-adapter.mjs",
    "release:smoke": "node scripts/release-pack-smoke.mjs",
    "release:validate": "node scripts/validate-npm-release.mjs",
    "release:verify-public": "node scripts/verify-npm-public-release.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs .release-evidence",
    "release:collect-public-evidence": "node scripts/collect-public-release-evidence.mjs .public-release-evidence",
    "peer-floor:check": "node scripts/peer-floor-consumer.mjs",
    "public:audit": "sh scripts/public-repository-audit.sh",
    "public:check": "node scripts/public-contract-policy.mjs && node scripts/documentation-policy.mjs && node site/verify.mjs && node scripts/public-beta-evidence.mjs",
    "beta:evidence:check": "node scripts/public-beta-evidence.mjs",
    "security:secrets": "sh scripts/secret-scan.sh",
    "security:workflow": "node scripts/workflow-security-policy.mjs",
    "toolchain:check": "node scripts/toolchain-policy.mjs && node scripts/platform-support-policy.mjs",
    "release": "sh scripts/with-declared-npm.sh sh -c 'npm run verify -- silent && npm run release:publish'",
    "release:publish": "sh scripts/with-declared-npm.sh node scripts/changeset-publish-adapter.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "esbuild": "^0.28.2",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "turbo": "^2.10.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "npm@12.0.2"
}
