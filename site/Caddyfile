vireocode.com {
	root * /srv/www/vireocode/current
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@deploymentProof path /.well-known/vireo-deployment.json
	header @deploymentProof Cache-Control "no-store"
	@metadata path /healthz /robots.txt /search-index.json /site.json /sitemap.xml /versions.json /manifest.webmanifest /sw.js /assets/asset-manifest.json
	header @metadata Cache-Control "no-cache"
	@versionedMetadata path_regexp versionedMetadata ^/docs/[^/]+/search-index\.json$
	header @versionedMetadata Cache-Control "no-cache"
	@html path *.html */
	header @html Cache-Control "no-cache"

	@immutableAssets path_regexp immutableAssets ^/assets/.+\.[a-f0-9]{12}\.(?:css|js)$
	header @immutableAssets Cache-Control "public, max-age=31536000, immutable"
	@mutableAssets path /assets/favicon.svg /assets/asset-manifest.json
	header @mutableAssets Cache-Control "no-cache"

	file_server

	handle_errors {
		@notFound expression {http.error.status_code} == 404
		rewrite @notFound /404.html
		file_server
	}
}

www.vireocode.com {
	redir https://vireocode.com{uri} permanent
}
