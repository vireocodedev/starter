{
  "schemaVersion": 1,
  "typescriptConsumer": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": false
  },
  "sourceMaps": {
    "allowSourcesContent": true,
    "requireRelativeSources": true,
    "packages": {
      "create-vireo": "forbidden",
      "@vireocodedev/history": "required",
      "@vireocodedev/infrastructure": "required",
      "@vireocodedev/localization": "required",
      "@vireocodedev/query": "required",
      "@vireocodedev/shell": "required",
      "@vireocodedev/sqlite": "required",
      "@vireocodedev/ui": "forbidden"
    }
  }
}
