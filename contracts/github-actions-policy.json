  "writePermissionJobs": {
    "attest-public-release.yml:attest": ["artifact-metadata", "attestations", "id-token"],
    "codeql.yml:analyze-javascript": ["security-events"],
    "codeql.yml:analyze-java": ["security-events"],
    "release-npm.yml:finalize-jvm": ["contents"],
    "release-npm.yml:publish": ["contents", "id-token"],
    "recover-maven-central-deployment.yml:finalize": ["contents"],
    "recover-maven-central-deployment.yml:resume": ["actions"],
    "storybook-pages.yml:deploy": ["id-token", "pages"]
  },
  "pullRequestWriteJobs": ["codeql.yml:analyze-javascript", "codeql.yml:analyze-java"],
  "mainOnlyManualWriteJobs": [
    "attest-public-release.yml:attest",
    "codeql.yml:analyze-javascript",
    "codeql.yml:analyze-java",
    "release-npm.yml:finalize-jvm",
    "release-npm.yml:publish",
    "recover-maven-central-deployment.yml:finalize",
    "recover-maven-central-deployment.yml:resume",
    "storybook-pages.yml:deploy"
  ],
  "requiredConcurrencyWorkflows": {
    "ci.yml": {
      "group": "ci-${{ github.workflow }}-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}",
      "cancelInProgress": true
    },
    "website.yml": {
      "group": "website-${{ github.event_name == 'pull_request' && format('pr-{0}', github.event.pull_request.number) || 'production' }}",
      "cancelInProgress": false
    },
    "anonymous-consumer-gauntlet.yml": {
      "group": "anonymous-consumer-gauntlet-${{ github.ref }}",
      "cancelInProgress": false
    }
  },
  "checkoutCredentialJobs": []
