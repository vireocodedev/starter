.npm-public-verification.json

# Research evidence committed under docs/roadmap/research/ is aggregate only.
# Raw participant material and identity mappings must remain in an approved,
# access-controlled system outside this repository.
docs/roadmap/research/raw/
docs/roadmap/research/participants/
docs/roadmap/research/recordings/
docs/roadmap/research/transcripts/

# jvm/ is a separate Gradle build. turbo never invokes Gradle and Gradle never
# invokes npm; the only thing they share is this repository.
jvm/build/
jvm/*/build/
jvm/.gradle/
jvm/buildSrc/.gradle/
# Written by the VS Code Java extension's Eclipse JDT builder, not by Gradle.
jvm/*/bin/
